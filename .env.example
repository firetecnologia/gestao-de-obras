# ============================================
# Dashboard de Obras — Núcleo 377
# Variáveis de Ambiente
# ============================================

# --- Modo 1: Service Account (recomendado) ---
# Crie uma service account no Google Cloud Console
# e compartilhe a planilha com o email da service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=sua-conta@seu-projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# --- Modo 2: API Key (para planilhas públicas) ---
# Se a planilha estiver publicada/compartilhada como "qualquer pessoa com o link",
# basta usar uma API Key.
# GOOGLE_API_KEY=sua_api_key_aqui

# --- Configuração do App ---
NEXT_PUBLIC_APP_NAME="Dashboard de Obras — Núcleo 377"
